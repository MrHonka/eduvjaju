# 📋 Шпаргалка по APT (Пакетный менеджер Ubuntu/Debian)

## 🔄 Работа со списками и обновлениями
sudo apt update             # Обновить локальную "карту" (индексы) пакетов из интернета. Ничего не устанавливает.
apt list --upgradable       # Показать список программ, для которых в интернете появились новые версии.
sudo apt upgrade            # Установить новые версии для всех разрешенных программ.

## 🚀 Принудительное и полное обновление
sudo apt full-upgrade       # Обновить ВСЁ, включая удержанные пакеты (Phased Updates), даже если ради этого придется удалить старые конфликтующие программы.
sudo apt install --only-upgrade [пакет] # Принудительно обновить конкретный удержанный пакет, не дожидаясь "волны".

## 📦 Установка и удаление софта
sudo apt install [пакет]     # Найти на "карте", скачать и установить программу со всеми ее зависимостями.
sudo apt remove [пакет]      # Удалить программу, но ОСТАВИТЬ её конфигурационные файлы в системе.
sudo apt purge [пакет]       # Удалить программу ПОЛНОСТЬЮ (вместе с конфигами, логами и зависимостями).

## 🔍 Поиск и информация
apt search [слово]          # Найти программу в репозитории по ключевому слову или описанию.
apt show [пакет]            # Показать подробную информацию о пакете (версия, размер, описание, зависимости).

## 🧼 Очистка системы (Освобождение места)
sudo apt autoremove         # Удалить «мусор» — библиотеки, которые ставились как зависимости для других программ, но теперь больше никому не нужны.
sudo apt clean              # Очистить кэш скачанных файлов .deb (освобождает место в /var/cache/apt/archives/).


